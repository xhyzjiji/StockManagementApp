{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event SessionStart --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event SessionEnd --workflow-dir .ttadk/.adk-mobile",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event UserPromptSubmit --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event PreToolUse --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event PreCompact --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event SubagentStart --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event SubagentStop --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/ttadk_mobile-core/adk-mobile-track/scripts/track.js\" --tool codex --event Stop --workflow-dir .ttadk/.adk-mobile",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
